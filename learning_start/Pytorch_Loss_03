import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader


# =========================
# 1. 创建一个简单数据集
# =========================

class MyDataset(Dataset):

    def __init__(self, n=100):
        self.x = torch.randn(n, 1, 28, 28)
        self.y = torch.randint(0, 2, (n,))

    def __len__(self):
        return len(self.x)

    def __getitem__(self, index):
        return self.x[index], self.y[index]


train_dataset = MyDataset(80)
val_dataset = MyDataset(20)

train_loader = DataLoader(
    train_dataset,
    batch_size=8,
    shuffle=True
)

val_loader = DataLoader(
    val_dataset,
    batch_size=4,
    shuffle=False
)


# =========================
# 2. 创建模型
# =========================

class MyModel(nn.Module):

    def __init__(self):
        super().__init__()

        self.conv = nn.Conv2d(
            1,
            8,
            3,
            padding=1
        )

        self.relu = nn.ReLU()

        self.pool = nn.MaxPool2d(2)

        self.fc = nn.Linear(
            8 * 14 * 14,
            2
        )

    def forward(self, x):

        x = self.conv(x)

        x = self.relu(x)

        x = self.pool(x)

        x = x.reshape(x.shape[0], -1)

        x = self.fc(x)

        return x


model = MyModel()


# =========================
# 3. Loss
# =========================

loss_function = nn.CrossEntropyLoss()


# =========================
# 4. Optimizer
# =========================

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)


# =========================
# 5. Training
# =========================

num_epochs = 5

for epoch in range(num_epochs):

    model.train()

    train_loss = 0

    for images, labels in train_loader:

        optimizer.zero_grad()

        outputs = model(images)

        loss = loss_function(
            outputs,
            labels
        )

        loss.backward()

        optimizer.step()

        train_loss += loss.item()


    # =========================
    # 6. Validation
    # =========================

    model.eval()

    val_loss = 0

    with torch.no_grad():

        for images, labels in val_loader:

            outputs = model(images)

            loss = loss_function(
                outputs,
                labels
            )

            val_loss += loss.item()


    print(
        f"Epoch {epoch + 1}: "
        f"train_loss={train_loss:.4f}, "
        f"val_loss={val_loss:.4f}"
    )