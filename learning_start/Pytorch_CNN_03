import torch
import torch.nn as nn


class UpBlock(nn.Module):

    def __init__(self):
        super().__init__()

        self.up = nn.ConvTranspose2d(
            16,
            8,
            2,
            stride=2
        )

    def forward(self, x, skip):

        x = self.up(x)

        x = torch.cat([x, skip], dim=1)

        return x


model = UpBlock()

x = torch.randn(2, 16, 64, 64)

skip = torch.randn(2, 8, 128, 128)

output = model(x, skip)

print(output.shape)