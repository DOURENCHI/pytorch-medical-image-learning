import torch
import torch.nn as nn

class MyModel(nn.Module):

    def __init__(self):
        super().__init__()

        self.fc = nn.Linear(3, 2)

    def forward(self, x):
        x = self.fc(x)
        return x

model = MyModel()

x=torch.randn(5,3)

#五个样本，每个样本有三个特征

output=model(x)

print("Input shape:", x.shape)
print("Output shape:", output.shape)
print("Model:",model)