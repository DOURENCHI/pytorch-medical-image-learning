import torch
import torch.nn as nn


class MiniUNet(nn.Module):

    def __init__(self):
        super().__init__()

        # Encoder
        self.conv1 = nn.Conv2d(1, 8, 3, padding=1)
        self.conv2 = nn.Conv2d(8, 16, 3, padding=1)

        self.relu = nn.ReLU()
        self.pool = nn.MaxPool2d(2)

        # Decoder
        self.up1 = nn.ConvTranspose2d(
            16, 8,
            kernel_size=2,
            stride=2
        )

        self.conv3 = nn.Conv2d(
            24, 8,
            3,
            padding=1
        )

        self.up2 = nn.ConvTranspose2d(
            8, 4,
            kernel_size=2,
            stride=2
        )

        self.out = nn.Conv2d(12, 1, 1)

    def forward(self, x):

        # Encoder
        x = self.conv1(x)
        x = self.relu(x)

        skip1 = x

        x = self.pool(x)

        x = self.conv2(x)
        x = self.relu(x)

        skip2 = x

        x = self.pool(x)

        # Decoder
        x = self.up1(x)

        x = torch.cat([x, skip2], dim=1)

        x = self.conv3(x)
        x = self.relu(x)

        x = self.up2(x)

        x = torch.cat([x, skip1], dim=1)

        x = self.out(x)

        return x


model = MiniUNet()

x = torch.randn(2, 1, 256, 256)

output = model(x)

print("input :", x.shape)
print("output:", output.shape)