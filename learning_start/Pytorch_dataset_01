from torch.utils.data import Dataset

class MyDataset(Dataset):
    def __init__(self):
        self.data = [1, 2, 3, 4, 5]
    def __len__(self):
        return len(self.data)
    def __getitem__(self, index):
        return self.data[index]

dataset = MyDataset()

print(dataset[0])
print(len(dataset))
print(dataset.data)