import torch
import torch.nn as nn


class MyCNN(nn.Module):

    def __init__(self):
        super().__init__()

        self.conv1 = nn.Conv2d(
                        1,
                        8,
                        3,
                        padding=1
        )
        self.relu1 = nn.ReLU()
        self.conv2 = nn.Conv2d(
                        8,
                        16,
                        3,
                        padding=1
        )
        self.relu2 = nn.ReLU()


    def forward(self, x):

        x = self.conv1(x)
        x = self.relu1(x)
        x = self.conv2(x)
        x = self.relu2(x)

        return x


model = MyCNN()

x = torch.randn(2, 1, 256, 256)

output = model(x)

print("input shape:", x.shape)
print("output shape:", output.shape)