import torch
import torch.nn as nn

from torch.utils.data import Dataset
from torch.utils.data import DataLoader


# =========================
# 1. Dataset
# =========================

class XrayDataset(Dataset):

    def __init__(self):

        self.images = torch.randn(
            20, 1, 64, 64
        )

        self.masks = torch.randint(
            0,
            2,
            (20, 1, 64, 64)
        ).float()

    def __len__(self):

        return len(self.images)

    def __getitem__(self, idx):

        return self.images[idx], self.masks[idx]


# =========================
# 2. DataLoader
# =========================

dataset = XrayDataset()

loader = DataLoader(
    dataset,
    batch_size=4,
    shuffle=True,
    num_workers=0
)


# =========================
# 3. Model
# =========================

class SimpleUNet(nn.Module):

    def __init__(self):

        super().__init__()

        self.conv1 = nn.Conv2d(
            1, 8, 3, padding=1
        )

        self.pool = nn.MaxPool2d(2)

        self.conv2 = nn.Conv2d(
            8, 16, 3, padding=1
        )

        self.up = nn.ConvTranspose2d(
            16, 8,
            kernel_size=2,
            stride=2
        )

        self.out = nn.Conv2d(
            8, 1, 1
        )

        self.relu = nn.ReLU()

    def forward(self, x):

        x = self.conv1(x)
        x = self.relu(x)

        x = self.pool(x)

        x = self.conv2(x)
        x = self.relu(x)

        x = self.up(x)

        x = self.out(x)

        return x


# =========================
# 4. Model / Loss / Optimizer
# =========================

model = SimpleUNet()

criterion = nn.BCEWithLogitsLoss()

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)


# =========================
# 5. Training
# =========================

for epoch in range(10):

    for images, masks in loader:

        # Forward
        output = model(images)

        # Loss
        loss = criterion(
            output,
            masks
        )

        # Backward
        optimizer.zero_grad()

        loss.backward()

        optimizer.step()

    print(
        "epoch:",
        epoch,
        "loss:",
        loss.item()
    )