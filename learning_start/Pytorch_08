import torch
import torch.nn as nn


class MyModel(nn.Module):

    def __init__(self):
        super().__init__()

        self.layer = nn.Linear(10, 2)

    def forward(self, x):
        return self.layer(x)


# 1. 创建模型
model = MyModel()

# 2. 加载训练好的参数
model.load_state_dict(
    torch.load("model.pth")
)

# 3. 进入评估模式
model.eval()

# 4. 准备一份新的数据
x = torch.randn(1, 10)

# 5. 推理
with torch.inference_mode():

    output = model(x)

print("预测结果:")
print(output)