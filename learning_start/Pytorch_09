import torch
import torch.nn as nn


class MiniSegNet(nn.Module):

    def __init__(self):
        super().__init__()

        self.encoder = nn.Sequential(
            nn.Conv2d(1, 16, 3, padding=1),
            nn.ReLU(),

            nn.MaxPool2d(2),

            nn.Conv2d(16, 32, 3, padding=1),
            nn.ReLU(),

            nn.MaxPool2d(2)
        )

        self.decoder = nn.Sequential(
            nn.ConvTranspose2d(
                32, 16,
                kernel_size=2,
                stride=2
            ),

            nn.ReLU(),

            nn.ConvTranspose2d(
                16, 1,
                kernel_size=2,
                stride=2
            )
        )

    def forward(self, x):

        x = self.encoder(x)

        x = self.decoder(x)

        return x

    
# 创建模型
model = MiniSegNet()

# 创建一批模拟 X-ray
x = torch.randn(8, 1, 512, 512)

# 输入模型
output = model(x)

print("输入 shape:", x.shape)
print("输出 shape:", output.shape)